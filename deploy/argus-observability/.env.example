# Bind OTLP to the receiver machine's internal address, not 0.0.0.0.
OTLP_BIND_ADDRESS=127.0.0.1

# Used only between the collector and the host-local ClickHouse service.
CLICKHOUSE_DATABASE=otel
CLICKHOUSE_USERNAME=contour
CLICKHOUSE_PASSWORD=replace-with-a-random-password

# Exact workload_information.unique_identifier for the one host Contour displays.
CONTOUR_ARGUS_HOST_ID=replace-with-an-argus-host-identity
